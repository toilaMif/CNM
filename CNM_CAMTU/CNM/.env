# ================= OLLAMA =================
# Tú khai báo các biến môi trường liên quan đến Ollama ở đấy
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:0.8b
# Tú thêm: model dùng để tạo embedding sản phẩm cho AI advisor.
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_NUM_PREDICT=300

# ================= RATE LIMIT =================
RATE_LIMIT_WINDOW_MS=900000 # 15 phút
RATE_LIMIT_MAX_REQUESTS=100 # tối đa 100 request mỗi 15 phút cho mỗi IP
# 

# Nếu muốn tắt auto embedding khi thêm/sửa sản phẩm, bạn có thể đặt biến này thành false
# AI_AUTO_SYNC_EMBEDDINGS=false

