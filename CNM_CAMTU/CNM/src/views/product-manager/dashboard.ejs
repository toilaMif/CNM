<div class="page-header">
  <div>
    <h1>Quản lý sản phẩm</h1>
    <p>Theo dõi hiệu quả sản phẩm, tồn kho và gợi ý nhập hàng.</p>
  </div>
</div>

<!-- SUMMARY CARDS -->
<section class="summary-grid">

  <div class="summary-card">
    <div class="summary-icon green">
      <i class="fa-solid fa-box"></i>
    </div>
    <span>Tổng sản phẩm</span>
    <h2 id="totalProducts">0</h2>
  </div>

  <div class="summary-card">
    <div class="summary-icon blue">
      <i class="fa-solid fa-circle-check"></i>
    </div>
    <span>Đang kinh doanh</span>
    <h2 id="activeProducts">0</h2>
  </div>

  <button
    type="button"
    class="summary-card summary-card-clickable"
    id="openOutOfStockModalBtn"
  >
    <div class="summary-icon red">
      <i class="fa-solid fa-circle-exclamation"></i>
    </div>
    <span>Sản phẩm hết hàng</span>
    <h2 id="outOfStockProducts">0</h2>
    <small>Bấm để xem danh sách</small>
  </button>


  <div class="summary-card">
    <div class="summary-icon purple">
      <i class="fa-solid fa-calendar-plus"></i>
    </div>
    <span>Sản phẩm mới tháng này</span>
    <h2 id="newProductsThisMonth">0</h2>
  </div>

</section>

