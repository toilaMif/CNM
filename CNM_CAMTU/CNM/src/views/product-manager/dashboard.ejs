<!-- OUT OF STOCK MODAL -->
<div id="outOfStockModal" class="pm-modal hidden">
  <div class="pm-modal-content pm-modal-large">

    <div class="pm-modal-header">
      <div>
        <h2>Sản phẩm hết hàng</h2>
        <p>Chọn sản phẩm cần chuyển sang tạo phiếu nhập kho.</p>
      </div>

      <button type="button" class="pm-modal-close" id="closeOutOfStockModalBtn">
        &times;
      </button>
    </div>

    <div class="pm-modal-actions">
      <label class="pm-check-all">
        <input type="checkbox" id="selectAllOutOfStock">
        Chọn tất cả
      </label>

      <button type="button" class="btn-primary" id="goToCreateImportBtn">
        <i class="fa-solid fa-truck-ramp-box"></i>
        Chuyển sang tạo phiếu nhập kho
      </button>
    </div>

    <div id="outOfStockProductList" class="out-stock-list">
      <p class="empty-text">Chưa có dữ liệu</p>
    </div>

  </div>
</div>