<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= typeof title !== 'undefined' ? title : 'Product Manager' %></title>

  <!-- Font Awesome -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  >

  <!-- Sidebar CSS dùng chung -->
  <link rel="stylesheet" href="/css/pages/product-manager/product-manager-sidebar.css">

  <!-- Layout CSS dùng chung -->
  <link rel="stylesheet" href="/css/pages/product-manager/product-manager-layout.css">

  <!-- CSS riêng từng trang -->
  <% if (typeof pageCss !== 'undefined' && pageCss) { %>
    <link rel="stylesheet" href="<%= pageCss %>">
  <% } %>
</head>

<body>

  <div class="product-manager-layout">

    <%- include('./product-manager-sidebar') %>

    <main class="pm-page <%= typeof pageClass !== 'undefined' ? pageClass : '' %>">
      <%- include(pageView) %>
    </main>

  </div>

  <!-- JS riêng từng trang -->
  <% if (typeof pageJs !== 'undefined' && pageJs) { %>
    <script src="<%= pageJs %>"></script>
  <% } %>

</body>

</html>