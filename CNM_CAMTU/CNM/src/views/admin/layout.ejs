<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= typeof title !== 'undefined' ? title : 'Admin' %></title>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  >

  <link rel="stylesheet" href="/css/pages/admin/admin-sidebar.css">
  <link rel="stylesheet" href="/css/pages/admin/admin-layout.css">

  <% if (typeof pageCss !== 'undefined' && pageCss) { %>
    <link rel="stylesheet" href="<%= pageCss %>">
  <% } %>
</head>

<body>

  <div class="admin-layout">

    <%- include('./admin-sidebar') %>

    <main class="admin-page <%= typeof pageClass !== 'undefined' ? pageClass : '' %>">
      <%- include(pageView) %>
    </main>

  </div>

  <% if (typeof pageJs !== 'undefined' && pageJs) { %>
    <script src="<%= pageJs %>"></script>
  <% } %>

</body>

</html>