<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập | Agro Distribution System</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>

    <link rel="stylesheet" href="/css/pages/auth/login.css" />
</head>

<!-- TOAST -->
<div id="toastContainer" class="toast-container"></div>

<body>

<div class="login-page">

    <div class="login-card">

        <!-- LEFT SIDE -->
        <div class="login-left">

            <div class="overlay"></div>

            <div class="left-content">

                <div class="logo-circle">
                    <i class="bi bi-leaf-fill"></i>
                </div>

                <h1>AGROVISION</h1>

                <p class="system-text">
                    Agriculture Distribution System
                </p>

                <p class="system-text">
                    Supply Chain Management Platform
                </p>

                <div class="line"></div>

                <p class="footer-text">
                    Quản lý chuỗi cung ứng nông sản hiệu quả
                </p>

            </div>

        </div>

        <!-- RIGHT SIDE -->
        <div class="login-right">

            <div class="form-wrapper">

                <div class="login-header">
                    <h2>Đăng nhập</h2>
                    <p>Đăng nhập để tiếp tục sử dụng hệ thống</p>
                </div>

                <!-- ALERT -->
                <div id="alertContainer"></div>

                <form id="loginForm">

                    <!-- EMAIL -->
                    <div class="input-group-custom">

                        <label>Email</label>

                        <div class="input-box">
                            <i class="bi bi-envelope"></i>

                            <input
                                type="email"
                                id="email"
                                placeholder="Nhập email"
                                required
                            />
                        </div>

                    </div>

                    <!-- PASSWORD -->
                    <div class="input-group-custom">

                        <label>Mật khẩu</label>

                        <div class="input-box">

                            <i class="bi bi-lock"></i>

                            <input
                                type="password"
                                id="password"
                                placeholder="••••••••"
                                required
                            />

                            <button
                                type="button"
                                id="togglePassword"
                                class="toggle-password"
                            >
                                <span id="toggleText">Show</span>
                            </button>

                        </div>

                    </div>

                    <!-- OPTIONS -->
                    <div class="form-options">

                        <div class="remember-box">
                            <input
                                type="checkbox"
                                id="rememberMe"
                            />

                            <label for="rememberMe">
                                Ghi nhớ đăng nhập
                            </label>
                        </div>

                        <a href="#" class="forgot-link">
                            Quên mật khẩu?
                        </a>

                    </div>

                    <!-- LOGIN BUTTON -->
                    <button type="submit" class="login-btn">
                        Đăng nhập
                    </button>

                    <div class="divider"></div>

                </form>

            </div>

        </div>

    </div>

</div>

<!-- FOOTER -->
<div class="system-footer">
    <span>
        <i class="bi bi-lightning-charge-fill"></i>
        AGROSHOP DIGITAL ECOSYSTEM
    </span>

    <span>
        AgroVision v2.4.0 • Secured Distribution
    </span>
</div>

<!-- PASSWORD TOGGLE -->
<script>
    const passwordInput = document.getElementById("password");
    const toggleBtn = document.getElementById("togglePassword");
    const toggleText = document.getElementById("toggleText");

    toggleBtn.addEventListener("click", () => {

        const isPassword = passwordInput.type === "password";

        passwordInput.type = isPassword ? "text" : "password";

        toggleText.textContent = isPassword
            ? "Hide"
            : "Show";
    });
</script>

<!-- LOGIN JS -->
<script src="/js/pages/auth/login.js"></script>

</body>
</html>