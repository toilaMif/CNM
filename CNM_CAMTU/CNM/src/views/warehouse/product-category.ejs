<main class="warehouse-product-page">

  <!-- HEADER -->
  <div class="page-header">

    <div class="page-header-left">
      <h1>Quản Lý Danh Mục Sản Phẩm</h1>
      <p>Hệ thống quản lý kho sản phẩm</p>
    </div>

    <!-- 
    <button id="openModalBtn" class="primary-btn">
      <i class="fa-solid fa-plus"></i>
      Thêm Sản Phẩm
    </button> 
    -->

  </div>

  <!-- STATS -->
  <div class="stats-grid">

    <div class="stats-card">

      <div class="stats-info">
        <h3>Tổng sản phẩm</h3>
        <p id="totalProducts">0</p>
      </div>

      <div class="stats-icon green">
        <i class="fa-solid fa-box"></i>
      </div>

    </div>

  </div>

  <!-- TABLE CARD -->
  <div class="table-card">

    <div class="table-header">
      <h2>
        <i class="fa-solid fa-boxes-stacked"></i>
        Danh sách sản phẩm
      </h2>
    </div>

    <div class="table-wrapper">

      <table class="product-table">

        <thead>
          <tr>
            <th>STT</th>
            <th>Mã sản phẩm</th>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th>Giá</th>
            <th>Đơn vị</th>
            <th>Số lượng</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
          </tr>
        </thead>

        <tbody id="productTableBody">
          <tr>
            <td colspan="9" class="empty-cell">
              Đang tải danh sách sản phẩm...
            </td>
          </tr>
        </tbody>

      </table>

    </div>

  </div>

</main>

<!-- MODAL -->
<div class="modal-overlay" id="productModal">

  <div class="modal-container">

    <!-- HEADER -->
    <div class="modal-header">

      <h2>Thêm sản phẩm</h2>

      <button
        type="button"
        class="close-modal-btn"
        id="closeModalBtn"
      >
        <i class="fa-solid fa-xmark"></i>
      </button>

    </div>

    <!-- FORM -->
    <form id="productForm" class="product-form">

      <div class="form-grid">

        <!-- PRODUCT NAME -->
        <div class="form-group">

          <label>Tên sản phẩm</label>

          <input
            type="text"
            name="name"
            placeholder="Nhập tên sản phẩm"
            required
          >

        </div>

        <!-- PRICE -->
        <div class="form-group">

          <label>Giá sản phẩm</label>

          <input
            type="number"
            name="price"
            placeholder="Nhập giá sản phẩm"
            required
          >

        </div>

        <!-- CATEGORY -->
        <div class="form-group">

          <label>Danh mục</label>

          <select
            name="categoryId"
            id="categorySelect"
            required
          >
            <option value="">
              Chọn danh mục
            </option>
          </select>

        </div>

        <!-- UNIT -->
        <div class="form-group">

          <label>Đơn vị</label>

          <select
            name="unitId"
            id="unitSelect"
            required
          >
            <option value="">
              Chọn đơn vị
            </option>
          </select>

        </div>

        <!-- STATUS -->
        <div class="form-group">

          <label>Trạng thái</label>

          <select
            name="statusId"
            required
          >
            <option value="1">
              Còn hàng
            </option>

            <option value="2">
              Hết hàng
            </option>

            <option value="4">
              Sắp hết hàng
            </option>
          </select>

        </div>

        <!-- QUANTITY -->
        <div class="form-group">

          <label>Số lượng</label>

          <input
            type="number"
            name="quantity"
            placeholder="Nhập số lượng"
            min="0"
          >

        </div>

      </div>

      <!-- DESCRIPTION -->
      <div class="form-group full-width">

        <label>Mô tả sản phẩm</label>

        <textarea
          name="description"
          placeholder="Nhập mô tả sản phẩm"
        ></textarea>

      </div>

      <!-- ACTIONS -->
      <div class="modal-actions">

        <button
          type="button"
          class="secondary-btn"
          id="cancelModalBtn"
        >
          Hủy
        </button>

        <button
          type="submit"
          class="primary-btn submit-btn"
        >
          Tạo sản phẩm
        </button>

      </div>

    </form>

  </div>

</div>